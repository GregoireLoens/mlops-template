# ============================================================
# Copier en .env (gitignore) — `make setup` le fait automatiquement.
# Principe : aucun secret dans le repo, tout passe par l'environnement.
# ============================================================

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_PORT=5000
# Backend du tracking store : sqlite par défaut (volume compose).
# Bascule postgres : décommenter puis `make up-postgres`.
#MLFLOW_BACKEND_STORE_URI=postgresql://mlflow:mlflow@postgres:5432/mlflow
#POSTGRES_PASSWORD=mlflow

# --- DVC : remote distant optionnel (sinon cache local) — étape 2 ---
#DVC_REMOTE_URL=s3://mon-bucket/mlops-template/dvc
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# --- Serving : registre MLflow — étape 10 ---
#MODEL_NAME=<nom du modèle dans le registre>
#MODEL_ALIAS=prod
# --- Monitoring BP3 : inference logging (JSONL horodaté, non-bloquant) ---
#LOG_INFERENCES=true
#INFERENCES_DIR=data/inferences
MLFLOW_ALLOWED_HOSTS=localhost,mlflow,127.0.0.1,mlflow:5000,localhost:5000
